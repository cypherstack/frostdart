{
  "name": "frostdart",
  "repository": "https://github.com/cypherstack/frostdart",
  "library": "hrf_api",
  "asset": "frostdart_bindings_generated.dart",
  "rust": {
    "workspace": "src/serai",
    "crate": "hrf-api"
  },
  "toolchains": {
